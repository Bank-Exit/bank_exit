<%= link_to project_path(project), class: "card card-lift" do %>
  <% if project.cover? %>
    <%= image_tag project.cover,
                  class: 'object-cover w-full h-60 rounded-t-lg',
                  alt: "Logo for #{project.title}",
                  loading: :lazy %>
  <% end %>

  <div class="card-body">
    <div class="card-title">
      <h3><%= project.title %></h3>
    </div>

    <p><%= project.overview %></p>
  </div>
<% end %>
