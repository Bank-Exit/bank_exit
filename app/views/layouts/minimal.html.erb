<!DOCTYPE html>

<html lang="<%= I18n.locale %>" data-theme="<%= @theme %>">
  <head>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'https://unpkg.com/leaflet@2.0.0-beta.4/dist/leaflet.css' %>
    <%= stylesheet_link_tag 'https://cdn.jsdelivr.net/npm/leaflet.markercluster@2.0.0-beta.1/dist/MarkerCluster.Default.css' %>

    <%= stylesheet_link_tag 'tailwind', "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag 'plugins/leaflet.css' %>

    <%= javascript_importmap_tags :map_embed %>
  </head>

  <body class="m-0">
    <%= yield %>
  </body>
</html>
