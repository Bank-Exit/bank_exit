<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <%= seo_meta_tags(@pagy) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= stylesheet_link_tag 'https://unpkg.com/leaflet@2.0.0-alpha.1/dist/leaflet.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/leaflet-gesture-handling@1.2.2/dist/leaflet-gesture-handling.min.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/@kristjan.esperanto/leaflet.markercluster@3/dist/MarkerCluster.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/@kristjan.esperanto/leaflet.markercluster@3/dist/MarkerCluster.Default.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/leaflet.fullscreen/dist/Control.FullScreen.css' %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%= render 'application/initial_javascript' %>
    <%= javascript_importmap_tags %>
  </head>

  <body
    class="admin bg-base-100"
    data-controller="theme"
    data-theme-light-value="<%= @themes[:light] %>"
    data-theme-dark-value="<%= @themes[:dark] %>"
  >
    <%= turbo_stream_from :flashes %>
    <%= turbo_stream_from [:flashes, I18n.locale] %>

    <div id="flashes">
      <%= render 'application/flashes' %>
    </div>

    <div class="drawer lg:drawer-open">
      <input id="admin-drawer" type="checkbox" class="drawer-toggle">

      <div class="drawer-content flex flex-col">
        <%= render "admin/shared/navbar", bell_counter: @bell_counter %>

        <main class="@container flex-1 p-4 space-y-4">
          <% if defined?(breadcrumbs) && breadcrumbs.count > 1 %>
            <div class="flex justify-between gap-5">
              <%= render 'application/breadcrumb', size: "text-sm" %>

              <% if content_for?(:page_actions) %>
                <%= content_for :dropdown_menu, flush: true do %>
                  <%= yield :page_actions %>
                <% end %>
                <%= render "application/dropdown_actions", item_id: "page_actions" %>
              <% end %>
            </div>
          <% end %>

          <%= yield %>
        </main>

        <%= render 'admin/shared/footer' %>
      </div>

      <div id="modal"></div>
      <%= render "application/modal", id: "turbo-confirm" %>
      <%= render 'admin/shared/sidebar' %>

      <%= render 'application/ribbon' if FeatureFlag.enabled?(:ribbon) %>
      <%= render 'application/debugbar' if defined?(Debugbar) %>
    </div>
  </body>
</html>
