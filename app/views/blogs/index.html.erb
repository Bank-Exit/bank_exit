<article>
  <header class="hero bg-fixed bg-banner-tutorials">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="max-w-xl space-y-5">
        <h1 class="text-3xl font-bold"><%= t('.title') %></h1>
      </div>
    </div>
  </header>

  <div class="article-body max-w-5xl">
    <%= render 'application/breadcrumb' %>

    <section>
      <ul class="list bg-base-200 rounded-box">
        <% @blogs.each do |blog| %>
          <li class="list-row hover:bg-base-300 transition-colors">
            <div
              class="
                <%= class_names(
                "size-12",
                "bg-cover",
                "rounded-full",
                "bg-#{blog.banner}": blog.banner,
                "bg-banner-default": !blog.banner
                ) %>
              "
            ></div>

            <div>
              <%= link_to blog_path(blog.identifier), class: "font-bold" do %>
                <h3><%= blog.title %></h3>
              <% end %>

              <p class="opacity-60"><%= blog.overview %></p>
            </div>

            <time class="badge badge-neutral"><%= l(blog.created_at) %></time>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</article>
