<%# locals: (directory:) %>

<% coin_wallets = directory.coin_wallets.enabled %>
<% delivery_zones = directory.delivery_zones.enabled %>

<tr>
  <th>
    <div class="flex items-center gap-3">
      <%= render 'application/logo_or_initials', model: directory %>

      <%= link_to directory_path(directory) do %>
        <%= directory.name %>
      <% end %>
    </div>
  </th>

  <td>
    <div class="flex items-center gap-3">
      <% coin_wallets.each do |coin_wallet| %>
        <%= image_tag icon_by_coin(coin_wallet.coin),
                      alt: coin_wallet.coin.capitalize,
                      title: coin_wallet.coin.capitalize,
                      class: 'w-8 h-8' %>
      <% end %>
    </div>
  </td>

  <td>
    <% if delivery_zones.any? %>
      <div class="tooltip">
        <div class="tooltip-content">
          <% delivery_zones.group_by(&:mode).each do |group| %>
            <% rows = group.last %>
            <% row = rows.first %>

            <p>
              <%= render 'delivery_zones/formatted_zone_by_mode',
                         delivery_zone: row %>
            </p>
          <% end %>
        </div>

        <%= render 'application/enabled_or_disabled', enabled: true %>
      </div>
    <% else %>
      <%= render 'application/enabled_or_disabled', enabled: false %>
    <% end %>
  </td>

  <td>
    <strong><%= directory.comments_count %></strong>
    <%= lucide_icon 'message-square', class: 'w-3.5 inline-flex ml-1' %>
  </td>

  <td>
    <%= render 'directories/contact_ways_list', directory: directory %>
  </td>

  <td>
    <%= show_link_to directory_path(directory, q: params[:query].presence) %>
  </td>
</tr>
