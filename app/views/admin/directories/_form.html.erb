<%# address_help / coin_wallet_help / delivery_zone_help %>
<% %w[address coin_wallet delivery_zone].each do |model_key| %>
  <%= render 'application/modal',
             id: "#{model_key}_help",
             modal_title: model_key.classify.constantize.model_name.human.capitalize,
             modal_body: t(".#{model_key}_body_help") %>
<% end %>

<%= simple_form_for [:admin, directory],
                    html: { class: 'space-y-5' } do |f| %>
  <% if directory.errors.any? %>
    <div class="alert alert-error mt-3">
      <ul class="list-disc list-inside">
        <% directory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="tabs tabs-box">
    <% locales_select_helper.each do |label_value, locale| %>
      <input
        class="tab"
        name="tabs_directory"
        type="radio"
        aria-label="<%= label_value %>"
        <% if locale == I18n.default_locale %>
          checked
        <% end %>
      >

      <div class="tab-content bg-base-100 border-base-300 rounded-box p-6 space-y-2">
        <% name = :"name_#{Mobility.normalize_locale(locale)}"
           description = :"description_#{Mobility.normalize_locale(locale)}" %>

        <%= f.input name, label: Directory.human_attribute_name(:name) %>
        <%= render 'application/description_with_counter', f: f, input_name: description %>
      </div>
    <% end %>
  </div>

  <%= f.input :category,
              prompt: :translate,
              collection: directories_categories_select_helper %>

  <% if params[:debug] == 'true' %>
    <%= f.input :position %>
  <% end %>

  <div class="flex flex-col lg:flex-row gap-3">
    <div class="space-y-2 lg:w-1/2">
      <%= f.input :logo, as: :file,
                  input_html: {
                    accept: Directory::ACCEPTED_CONTENT_TYPES.join(',')
                  } %>

      <% if f.object.logo.attached? %>
        <%= f.input :remove_logo, as: :boolean %>
        <div class="avatar">
          <div class="w-40 rounded-full">
            <%= image_tag url_for(f.object.logo), alt: "Logo" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-2 lg:w-1/2">
      <%= f.input :banner, as: :file,
                  input_html: {
                    accept: Directory::ACCEPTED_CONTENT_TYPES.join(',')
                  } %>

      <% if f.object.banner.attached? %>
        <%= f.input :remove_banner, as: :boolean %>
        <p><%= image_tag url_for(f.object.banner), alt: "Banner" %></p>
      <% end %>
    </div>
  </div>

  <section class="space-y-3">
    <div class="flex items-center gap-1 mb-2 border-b-2 text-primary">
      <h2 class="text-lg font-bold">
        <%= Address.model_name.human.capitalize %>
      </h2>

      <button
        type="button"
        class="btn btn-ghost btn-xs btn-circle"
        commandfor="address_help"
        command="show-modal"
      >
        <%= lucide_icon 'info', class: 'w-4' %>
      </button>
    </div>

    <div
      data-controller="admin--address"
      data-admin--address-search-url-value="<%= addresses_search_path %>"
    >
      <%= f.simple_fields_for :address do |ff| %>
        <%= ff.input :label,
                      wrapper_html: { class: 'mb-2' },
                      input_html: {
                        list: "addresses",
                        data: {
                          admin__address_target: :input,
                          action: "input->admin--address#search"
                        }
                      },
                      hint: false %>
      <% end %>

      <datalist data-admin--address-target="datalist" id="addresses"></datalist>
    </div>

    <% if f.object.address.persisted? %>
      <ul class="bg-base-200 list-disc list-inside p-5 rounded-box text-sm opacity-60">
        <li>
          Street: <%= f.object.address.street %>
        </li>

        <li>
          Postal code: <%= f.object.address.postcode %>
        </li>

        <li>
          City: <%= f.object.address.city %>
        </li>

        <li>
          Country: <%= f.object.address.country %>
        </li>

        <li>
          Latitude: <%= f.object.address.latitude %>
        </li>

        <li>
          Latitude: <%= f.object.address.longitude %>
        </li>
      </ul>
    <% end %>
  </section>

  <section class="space-y-3 mb-3">
    <div class="flex items-center gap-1 mb-2 border-b-2 text-primary">
      <h2 class="text-lg font-bold">
        <%= CoinWallet.model_name.human.capitalize %>
      </h2>

      <button
        type="button"
        class="btn btn-ghost btn-xs btn-circle"
        commandfor="coin_wallet_help"
        command="show-modal"
      >
        <%= lucide_icon 'info', class: 'w-4' %>
      </button>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-3"
      data-controller="nested-form"
    >
      <%= f.simple_fields_for :coin_wallets,
                              directory.coin_wallets,
                              wrapper: false,
                              include_id: false do |ff| %>
        <%= render 'directories/coin_wallets_fields', f: ff %>
      <% end %>

      <template data-nested-form-target="template">
        <%= f.simple_fields_for :coin_wallets,
                                directory.coin_wallets.new,
                                child_index: 'TEMPLATE_RECORD' do |ff| %>
          <%= render 'directories/coin_wallets_fields', f: ff %>
        <% end %>
      </template>

      <%= button_tag t('.new_coin_wallet'),
                     class: 'btn btn-success col-span-2 col-start-1 col-end-1',
                     data: {
                       nested_form_target: 'addItem',
                       action: "click->nested-form#addAssociation"
                     } %>
    </div>
  </section>

  <section class="space-y-3 mb-3">
    <div class="flex items-center gap-1 mb-2 border-b-2 text-primary">
      <h2 class="text-lg font-bold">
        <%= DeliveryZone.model_name.human.capitalize %>
      </h2>

      <button
        type="button"
        class="btn btn-ghost btn-xs btn-circle"
        commandfor="delivery_zone_help"
        command="show-modal"
      >
        <%= lucide_icon 'info', class: 'w-4' %>
      </button>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-3"
      data-controller="nested-form"
    >
      <%= f.simple_fields_for :delivery_zones,
                              directory.delivery_zones,
                              wrapper: false,
                              include_id: false do |ff| %>
        <%= render 'directories/delivery_zones_fields', f: ff %>
      <% end %>

      <template data-nested-form-target="template">
        <%= f.simple_fields_for :delivery_zones,
                                directory.delivery_zones.new,
                                child_index: 'TEMPLATE_RECORD' do |ff| %>
          <%= render 'directories/delivery_zones_fields', f: ff %>
        <% end %>
      </template>

      <%= button_tag t('.new_delivery_zone'),
                     class: 'btn btn-success col-span-3 col-start-1 col-end-1',
                     data: {
                       nested_form_target: 'addItem',
                       action: "click->nested-form#addAssociation"
                     } %>
    </div>
  </section>

  <section class="space-y-3 mb-3">
    <h2 class="text-lg font-bold text-primary mb-2 border-b-2">
      <%= ContactWay.model_name.human.capitalize %>
    </h2>

    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-3"
      data-controller="nested-form"
    >
      <%= f.simple_fields_for :contact_ways,
                              directory.contact_ways,
                              wrapper: false,
                              include_id: false do |ff| %>
        <%= render 'directories/contact_ways_fields', f: ff %>
      <% end %>

      <template data-nested-form-target="template">
        <%= f.simple_fields_for :contact_ways,
                                directory.contact_ways.new,
                                child_index: 'TEMPLATE_RECORD' do |ff| %>
          <%= render 'directories/contact_ways_fields', f: ff %>
        <% end %>
      </template>

      <%= button_tag t('.new_contact_way'),
                     class: 'btn btn-success col-span-3 col-start-1 col-end-1',
                     data: {
                       nested_form_target: 'addItem',
                       action: "click->nested-form#addAssociation"
                     } %>
    </div>
  </section>

  <section class="space-y-3 mb-3">
    <h2 class="text-lg font-bold text-primary mb-2 border-b-2">
      <%= Weblink.model_name.human.capitalize %>
    </h2>

    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-3"
      data-controller="nested-form"
    >
      <%= f.simple_fields_for :weblinks,
                              directory.weblinks,
                              wrapper: false,
                              include_id: false do |ff| %>
        <%= render 'directories/weblinks_fields', f: ff %>
      <% end %>

      <template data-nested-form-target="template">
        <%= f.simple_fields_for :weblinks,
                                directory.weblinks.new,
                                child_index: 'TEMPLATE_RECORD' do |ff| %>
          <%= render 'directories/weblinks_fields', f: ff %>
        <% end %>
      </template>

      <%= button_tag t('.new_weblink'),
                     class: 'btn btn-success col-span-3 col-start-1 col-end-1',
                     data: {
                       nested_form_target: 'addItem',
                       action: "click->nested-form#addAssociation"
                     } %>
    </div>
  </section>

  <%= f.input :spotlight %>
  <%= f.input :enabled %>
  <%= f.button :submit %>
<% end %>
