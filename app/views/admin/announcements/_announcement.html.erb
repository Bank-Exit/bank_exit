<tr
  class="<%= class_names('opacity-25': announcement.overpass?) %>"
  title="<%= t('.date_overpass_title') if announcement.overpass? %>"
>
  <td class="text-center">
    <% if announcement.picture.attached? %>
      <%= image_tag url_for(announcement.picture.variant(:thumb)), class: 'w-16 rounded-lg mx-auto', alt: announcement.title %>
    <% else %>
      -
    <% end %>
  </td>

  <th><%= announcement.title %></th>

  <td>
    <% if announcement.link_to_visit.present? %>
      <%= link_to t('link'), announcement.link_to_visit, target: :_blank %>
    <% else %>
      -
    <% end %>
  </td>

  <td>
    <div class="badge <%= announcement_color_by_mode(announcement.mode) %>">
      <%= Announcement.human_enum_name(:modes, announcement.mode) %>
    </div>
  </td>

  <td>
    <% if announcement.published_at %>
      <%= I18n.l(announcement.published_at) %>
    <% else %>
      -
    <% end %>
  </td>

  <td>
    <% if announcement.unpublished_at %>
      <%= I18n.l(announcement.unpublished_at) %>
    <% else %>
      -
    <% end %>
  </td>

  <td>
    <% if announcement.enabled? %>
      <div
        aria-label="Status"
        class="
          status status-lg status-success flex items-center justify-center
          w-5 h-5 rounded-full
        "
      >
        <%= lucide_icon 'check', class: 'text-success-content' %>
      </div>
    <% else %>
      <div
        aria-label="Status"
        class="
          status status-lg status-error flex items-center justify-center w-5
          h-5 rounded-full
        "
      >
        <%= lucide_icon 'x', class: 'text-error-content' %>
      </div>
    <% end %>
  </td>

  <td>
    <%= render 'admin/announcements/actions', announcement: announcement %>
  </td>
</tr>
