<tr class="<%= class_names('opacity-25': !user.enabled?) %>">
  <th><%= user.email_address %></th>

  <td>
    <div class="badge <%= user_badge_color_for_role(user.role) %>">
      <%= User.human_enum_name(:role, user.role) %>
    </div>
  </td>

  <td><%= l(user.created_at) %></td>

  <td>
    <% if user.enabled? %>
      <%= status_icon :success %>
    <% else %>
      <%= status_icon :error %>
    <% end %>
  </td>

  <td>
    <div class="flex items-center justify-end gap-2">
      <% if allowed_to?(:impersonate?, user) %>
        <%= button_to t('.logged_in_as'),
                      impersonate_admin_user_path(user),
                      class: 'btn btn-secondary btn-sm',
                      data: {
                        turbo_confirm: t('.logged_in_as_confirm_html', email: user.email_address) } %>
      <% end %>

      <%= render 'admin/users/actions', user: user %>
    </div>
  </td>
</tr>
