<%# locals: (merchant:) %>

<tr>
  <% if allowed_to?(:destroy?, with: Admin::Merchants::BatchActionPolicy) %>
    <td>
      <label>
        <%= check_box_tag 'merchant[id]',
                          merchant.id,
                          false,
                          class: 'checkbox checked:border-primary checked:bg-primary checked:text-primary-content',
                          disabled: merchant.available?,
                          data: {
                            admin__table_target: 'checkbox',
                            action: 'input->admin--table#toggle'
                          } %>
      </label>
    </td>
  <% end %>

  <td>
    <%= render 'application/logo_or_initials',
               model: merchant,
               mode: :large %>
  </td>

  <th scope="row">
    <div class="whitespace-nowrap">
      <div
        class="text-base font-semibold truncate max-w-72"
        title="<%= merchant.name %>"
      >
        <%= link_to admin_merchant_path(merchant) do %>
          <%= highlight(merchant.name, params[:query]) %>
        <% end %>
      </div>

      <div class="font-semibold text-gray-500 mb-2">
        <%= highlight("##{merchant.identifier}", params[:query]) %>
      </div>

      <div class="truncate max-w-72">
        <%= highlight(formatted_address(merchant.address_lines), params[:query]) %>
      </div>
    </div>
  </th>

  <td>
    <div class="flex flex-col gap-2">
      <%= merchant_icon_svg(merchant.icon, width: 50, height: 50) %>

      <div class="text-xs">
        <%= t(merchant.category, scope: 'categories') %>
      </div>
    </div>
  </td>

  <td>
    <%= coins_list(merchant.coins,
                   with_logo: true,
                   with_name: false,
                   size: 'w-6') %>
  </td>

  <td>
    <strong><%= merchant.comments_count %></strong>
    <%= lucide_icon 'message-square', class: 'w-4 inline-flex ml-1' %>
  </td>

  <td>
    <div
      class="<%= class_names('status status-lg', 'status-error': merchant.deleted?, 'status-success': !merchant.deleted?) %>"
      aria-label="Status"
    ></div>

    <% if merchant.deleted? %>
      <span class="tooltip" data-tip="<%= l(merchant.deleted_at) %>">
        <%= t('disabled') %>
      </span>
    <% else %>
      <%= t('enabled') %>
    <% end %>
  </td>

  <td class="<%= 'text-center' if merchant.updated? %>">
    <p
      class="tooltip"
      data-tip="<%= Merchant.human_attribute_name(:created_at) %>"
    >
      <%= l(merchant.created_at) %>
    </p>

    <% if merchant.updated? %>
      <%= lucide_icon 'move-left',
                      class: 'mx-auto w-5 h-5 -rotate-90 bg-primary text-primary-content rounded-full my-2 p-1' %>
      <p
        class="tooltip"
        data-tip="<%= Merchant.human_attribute_name(:updated_at) %>"
      >
        <%= l(merchant.updated_at) %>
      </p>
    <% end %>
  </td>

  <td>
    <%= render 'admin/merchants/actions', merchant: merchant %>
  </td>
</tr>
