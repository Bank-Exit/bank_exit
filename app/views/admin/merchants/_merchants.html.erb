<%# locals: (merchants:, pagy:) %>

<% can_batch_merchants = allowed_to?(:destroy?, with: Admin::Merchants::BatchActionPolicy) %>

<section class="space-y-3" data-controller="admin--table">
  <% if can_batch_merchants %>
    <%= render 'admin/merchants/batch_actions' %>
  <% end %>

  <div class="table-wrapper">
    <table class="table table-zebra">
      <thead>
        <tr>
          <% if can_batch_merchants %>
            <th scope="col">
              <%= check_box_tag nil,
                                nil,
                                false,
                                class: 'checkbox bg-white/5 checked:border-primary checked:bg-primary checked:text-primary-content',
                                data: {
                                  action: 'input->admin--table#toggleAll'
                                } %>
            </th>
          <% end %>

          <th scope="col">
            <%= Merchant.human_attribute_name(:logo) %>
          </th>

          <th scope="col">
            <%= Merchant.human_attribute_name(:name) %>
          </th>

          <th scope="col">
            <%= Merchant.human_attribute_name(:category) %>
          </th>

          <th scope="col">
            <%= Merchant.human_attribute_name(:coins) %>
          </th>

          <th scope="col">
            <%= Comment.model_name.human.capitalize %>
          </th>

          <th scope="col">
            <%= t('status') %>
          </th>

          <th scope="col">
            <%= t('date_title') %>
          </th>

          <th scope="col">
            <%= t('actions') %>
          </th>
        </tr>
      </thead>

      <tbody>
        <%= render merchants %>

        <% if merchants.blank? %>
          <tr>
            <td class="text-center italic" colspan="100%">
              <%= t('.empty_results') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'application/pagination', pagy: pagy %>
</section>
