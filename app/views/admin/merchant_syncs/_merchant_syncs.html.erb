<%# locals: (merchant_syncs:, pagy:) %>

<section class="space-y-3">
  <div class="table-wrapper">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th scope="col">
            <%= MerchantSync.human_attribute_name(:id) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:instigator) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:mode) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:started_at) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:ended_at) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:added_merchants_count) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:updated_merchants_count) %>
          </th>

          <th scope="col">
            <%= MerchantSync.human_attribute_name(:soft_deleted_merchants_count) %>
          </th>

          <th scope="col">
            <%= t('status') %>
          </th>

          <th scope="col">
            <%= t('actions') %>
          </th>
        </tr>
      </thead>

      <tbody id="merchant_syncs">
        <%= render merchant_syncs %>

        <% if merchant_syncs.blank? %>
          <tr id="merchant_syncs_empty">
            <td class="text-center italic" colspan="100%">
              <%= t('.empty_results') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'application/pagination',
             pagy: pagy,
             use_turbo_stream: true,
             add_page_to_url: true,
             scroll_top: true %>
</section>
