<article>
  <header class="hero bg-fixed bg-banner-tutorials">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="max-w-xl space-y-5">
        <h1 class="text-3xl font-bold">
          <%= t('.title') %>
        </h1>
      </div>
    </div>
  </header>

  <div class="article-body max-w-5xl space-y-8!">
    <%= render 'application/breadcrumb' %>

    <% if @highlighted_tutorials.present? %>
      <section>
        <h2 class="text-primary uppercase mb-3">
          <%= t('.features_tutorials_title') %>
        </h2>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 content-center align-center">
          <%= render @highlighted_tutorials %>
        </div>
      </section>
    <% end %>

    <section>
      <h2 class="text-primary uppercase mb-3">
        <%= t('.other_tutorials_title') %>
      </h2>

      <ul class="list bg-base-200 rounded-box">
        <% @other_tutorials.each do |tutorial| %>
          <li class="list-row hover:bg-base-300 transition-colors">
            <% if tutorial.coins.present? %>
              <%= group_coins_list(tutorial.coins, size: 'size-12') %>
            <% else %>
              <div
                class="
                  <%= class_names(
                  "size-12",
                  "bg-cover",
                  "bg-#{tutorial.banner}": tutorial.banner,
                  "bg-banner-default": !tutorial.banner
                  ) %>
                "
              ></div>
            <% end %>

            <div>
              <%= link_to tutorial_path(tutorial.identifier), class: "font-bold" do %>
                <h3><%= tutorial.title %></h3>
              <% end %>

              <p class="opacity-60"><%= tutorial.overview %></p>
            </div>

            <div class="max-md:list-col-wrap">
              <% if tutorial.level? %>
                <span class="badge badge-sm <%= tutorial_class_by_level(tutorial.level) %>">
                  <%= t(tutorial.level, scope: 'articles.wrapper') %>
                </span>
              <% end %>

              <% if tutorial.time? %>
                <span
                  class="badge badge-sm badge-neutral"
                  title="<%= tutorial.time %>'"
                >
                  <%= distance_of_time_in_words(tutorial.time.minutes) %>
                </span>
              <% end %>

              <% if tutorial.created_at? %>
                <span class="badge badge-sm">
                  <%= I18n.l(tutorial.created_at) %>
                </span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</article>
