<%= link_to tutorial_path(tutorial.identifier), class: "card card-lift" do %>
  <% if tutorial.logo? %>
    <%= image_tag tutorial.logo,
            class: 'bg-base-300 object-cover md:h-60 rounded-t-lg p-5',
            alt: "Logo for #{tutorial.title}",
            loading: :lazy %>
  <% end %>

  <div class="card-body justify-between gap-3">
    <div class="card-title text-center">
      <h3><%= tutorial.title %></h3>
    </div>

    <div class="flex flex-col items-center gap-2">
      <p class="badge badge-sm <%= tutorial_class_by_level(tutorial.level) %>">
        <%= t(tutorial.level, scope: 'articles.wrapper') %>
      </p>

      <% if tutorial.time? %>
        <p class="badge badge-sm badge-neutral" title="<%= tutorial.time %>">
          <%= distance_of_time_in_words(tutorial.time.minutes) %>
        </p>
      <% end %>

      <% if tutorial.created_at %>
        <p class="badge badge-sm">
          <%= l(tutorial.created_at) %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>
