<%# locals: (merchants:, pagy:, query:) %>

<div
  id="merchants_results"
  class="
    relative w-full h-full md:w-1/2 xl:w-2/3 px-3 py-3 space-y-3
    scroll-mt-20
  "
>
  <% if merchants.any? %>
    <% if merchants_as_table? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra lg:table-fixed w-max min-w-full lg:w-auto">
          <thead>
            <tr>
              <td><%= Merchant.human_attribute_name(:logo) %></td>
              <td><%= Merchant.human_attribute_name(:name) %></td>
              <td><%= Merchant.human_attribute_name(:category) %></td>
              <td><%= Merchant.human_attribute_name(:country) %></td>
              <td><%= Merchant.human_attribute_name(:coins) %></td>
              <td><%= Merchant.human_attribute_name(:contact) %></td>
              <td><%= t("actions") %></td>
            </tr>
          </thead>

          <tbody>
            <% merchants.each do |merchant| %>
              <%= render "maps/merchants_table_row", merchant: merchant, query: query %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif merchants_as_grid? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <%= render merchants %>
      </div>
    <% end %>
    <%= render "application/pagination",
               pagy: pagy,
               use_turbo_stream: true,
               add_page_to_url: true,
               scroll_top: true %>
  <% else %>
    <div
      class="
        flex flex-col items-center justify-center gap-3 text-base-content/60
        py-10
      "
    >
      <%= lucide_icon "store", class: "w-40 h-auto" %>

      <p class="text-lg">
        <%= t("empty_results") %>
      </p>
    </div>
  <% end %>
</div>
