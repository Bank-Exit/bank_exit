<%= render "maps/merchants_filters", query: @query, pagy: @pagy, merchant_sync: @merchant_sync %>

<div
  class="map-layout"
  data-controller="map-wrapper"
  data-action="map--filter:mapCollapsed@document->map-wrapper#onMapCollapsed"
  data-map-wrapper-expand-label-value="<%= t('.expand_map') %>"
  data-map-wrapper-collapse-label-value="<%= t('.collapse_map') %>"
>
  <%= render "maps/merchants", merchants: @merchants, query: @query, pagy: @pagy %>

  <aside class="map-container" data-map-wrapper-target="map">
    <div class="sticky top-36 h-full lg:h-[calc(100dvh-10rem)] lg:mt-16">
      <%= render 'maps/map', latitude: @latitude,
                             longitude: @longitude,
                             zoom: @zoom %>

      <div class="absolute left-5 right-5 md:left-25 md:right-25 bottom-4 z-999">
        <%= render "maps/directory_friends", directory_friends: @directory_friends %>
      </div>
    </div>
  </aside>
</div>

<%= render 'maps/page_header' %>

<% if @faqs.any? %>
  <%= render template: 'faqs/show' %>
<% end %>

<%= render 'welcome/coins', coins: @all_coins %>
