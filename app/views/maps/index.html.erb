<%= render 'maps/page_header' %>

<div class="flex flex-col md:flex-row items-start">
  <%= render 'maps/sidebar', merchant_sync: @merchant_sync, pagy: @pagy, h_screen: false do %>
    <%= render "maps/directory_friends", directory_friends: @directory_friends %>
  <% end %>

  <%= render 'maps/merchants_table_or_grid', merchants: @merchants, pagy: @pagy, query: @query %>
</div>

<% if @faqs.any? %>
  <%= render template: 'faqs/show' %>
<% end %>

<%= render 'welcome/coins', coins: @all_coins %>
