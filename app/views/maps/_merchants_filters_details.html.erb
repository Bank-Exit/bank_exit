<%# locals: (query:) %>

<% if query.present? %>
  <p class="badge badge-soft badge-lg font-bold max-w-64">
    <%= lucide_icon "search", class: "w-4 shrink-0" %>

    <span class="truncate min-w-0">
      <%= query %>
    </span>
  </p>
<% end %>

<% if params[:category].present? %>
  <p class="badge badge-soft badge-lg">
    <%= lucide_icon "tag", class: "w-4" %>
    <%= I18n.t(params[:category], scope: :categories) %>
  </p>
<% end %>

<% if params[:continent].present? %>
  <p class="badge badge-soft badge-lg">
    <%= lucide_icon "earth", class: "w-8" %>
    <%= I18n.t(params[:continent], scope: :continents) %>
  </p>
<% elsif params[:country].present? %>
  <p class="badge badge-soft badge-lg">
    <%= formatted_country(params[:country]) %>
  </p>
<% end %>
