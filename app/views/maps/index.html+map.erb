<div class="flex max-md:flex-col-reverse items-start">
  <%= render 'maps/sidebar', merchant_sync: @merchant_sync, pagy: @pagy do %>
    <div id="map_results">
      <%= render 'maps/merchants', merchants: @merchants, pagy: @pagy, query: @query %>
    </div>
  <% end %>

  <div class="relative w-full h-full md:w-1/2 xl:w-2/3 <%= map_css_height %>">
    <%= render 'maps/map', latitude: @latitude,
                           longitude: @longitude,
                           zoom: @zoom %>

    <% if @directory_friends.present? %>
      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-0 w-[90%] lg:w-[75%]">
        <%= render 'maps/directory_friends', directory_friends: @directory_friends %>
      </div>
    <% end %>
  </div>
</div>

<%= render 'maps/page_header' %>

<% if @faqs.any? %>
  <%= render template: 'faqs/show' %>
<% end %>

<%= render 'welcome/coins', coins: @all_coins %>
