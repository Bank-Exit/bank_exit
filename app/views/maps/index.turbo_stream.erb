<%= turbo_stream.replace :map_results do %>
  <%= render 'maps/merchants', merchants: @merchants, query: @query, pagy: @pagy %>
<% end %>

<% unless params[:display].present? %>
  <%= turbo_stream.replace :merchants_filters do %>
    <%= render 'maps/merchants_filters', query: @query, pagy: @pagy, merchant_sync: @merchant_sync %>
  <% end %>

  <% unless from_pagination? %>
    <%= turbo_stream.replace :map do %>
      <%= render 'maps/map', latitude: @latitude,
                             longitude: @longitude,
                             zoom: @zoom,
                             map_class: "rounded-box" %>
    <% end %>
  <% end %>
<% end %>
