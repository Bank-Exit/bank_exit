<%# locals: (directory_friends:) %>

<details
  open
  data-controller="directory-friends"
  class="
    collapse collapse-arrow rounded-box border border-base-300
    bg-base-200/90 max-w-2xl mx-auto
  "
>
  <summary
    id="directory-friends"
    class="collapse-title py-4 text-center text-sm font-semibold text-primary"
  >
    <%= t(".other_directories_to_spend_title") %>
  </summary>

  <div class="collapse-content px-3 pb-3 overflow-x-auto scrollbar-thin">
    <ul class="flex flex-nowrap justify-start">
      <% directory_friends.each do |directory_friend| %>
        <% image_size = "size-10 lg:size-12 bg-transparent" %>

        <li class="shrink-0">
          <%= link_to directory_friend.link,
                  target: :_blank,
                  rel: "noopener",
                  class: "group flex w-24 flex-col items-center gap-2 rounded-box p-2 text-center hover:bg-base-100 focus-visible:bg-base-100 no-blank-icon" do %>
            <div class="flex size-12 items-center justify-center">
              <% if directory_friend.icon? %>
                <%= lucide_icon directory_friend.icon,
                        class: image_size %>
              <% elsif directory_friend.image? %>
                <%= image_tag "directory_friends/#{directory_friend.image}",
                        class: "#{image_size} rounded-lg object-cover",
                        alt: directory_friend.name %>
              <% elsif directory_friend.svg_image? %>
                <%= inline_svg_tag "directory_friends/#{directory_friend.svg_image}",
                        class: image_size,
                        alt: directory_friend.name %>
              <% end %>
            </div>

            <span class="directory-friend-name text-xs font-medium leading-tight">
              <%= directory_friend.name %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</details>
