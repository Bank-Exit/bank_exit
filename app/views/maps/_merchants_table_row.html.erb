<%# locals: (merchant:, query:) %>

<tr class="hover:bg-base-300 transition-colors">
  <th>
    <%= link_to merchant_path(merchant) do %>
      <%= highlight(merchant.name, query) %>
    <% end %>
  </th>

  <td>
    <span class="badge badge-sm badge-warning h-auto whitespace-normal py-1 text-left">
      <%= merchant_icon_svg(merchant.icon, size: 'size-4', naked: true) %>
      <%= merchant.friendly_category %>
    </span>
  </td>

  <td>
    <%= formatted_country(merchant.country) %>
  </td>

  <td>
    <%= group_coins_list(merchant.coins, size: "w-7") do %>
      <% unless merchant.ask_kyc.nil? %>
        <%= merchant_kyc_no_kyc(merchant.ask_kyc?) %>
      <% end %>
    <% end %>
  </td>

  <td>
    <%= show_link_to merchant_path(merchant) %>
  </td>
</tr>
