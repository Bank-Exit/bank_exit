<%# locals: (merchant:, query:) %>

<tr class="hover:bg-base-300 transition-colors">
  <th>
    <%= link_to merchant_path(merchant) do %>
      <%= highlight(merchant.name, query) %>
    <% end %>
  </th>

  <td>
    <div class="flex items-center gap-2">
      <%= merchant_icon_svg(merchant.icon, width: 35, height: 35) %>

      <div class="text-xs">
        <%= t(merchant.category, scope: "categories") %>
      </div>
    </div>
  </td>

  <td>
    <%= formatted_country(merchant.country) %>
  </td>

  <td>
    <div class="flex items-center gap-2">
      <%= coins_list(
            merchant.coins,
            with_logo: true,
            with_name: false,
            size: "w-6",
            inline: true
          ) %>

      <% unless merchant.ask_kyc.nil? %>
        <%= merchant_kyc_no_kyc(
              merchant.ask_kyc?,
              klass: "w-6 h-6 text-[10px]"
            ) %>
      <% end %>
    </div>
  </td>

  <td>
    <%= show_link_to merchant_path(merchant) %>
  </td>
</tr>
