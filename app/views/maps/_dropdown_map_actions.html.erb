<%# locals: (merchant_sync:) %>

<% content_for(:dropdown_header) do %>
  <div class="px-4 py-2 text-sm bg-base-300 text-center rounded-t-box">
    <p class="font-bold">
      <%= t(".map_title") %>
    </p>

    <% if merchant_sync %>
      <p class="text-xs mt-1">
        <%= t(".last_updated_at", last_updated_at: l(merchant_sync.ended_at)) %>
      </p>
    <% end %>
  </div>
<% end %>

<% content_for(:dropdown_menu) do %>
  <li class="border-b border-base-content/20 pb-2">
    <%= render "statistics/include_atms_input", center: false %>
  </li>

  <% if merchants_as_map? %>
    <li>
      <%= simple_form_for "" do |f| %>
        <%= f.input :fit_bounds,
              as: :boolean,
              boolean_style: :inline,
              wrapper: false,
              input_html: {
                data: {
                  action: "change->map--options#toggleFitBounds",
                  map__options_target: "fitBounds"
                }
              },
              label: t(".map_fit_bounds") %>
      <% end %>
    </li>
    <li>
      <%= simple_form_for "" do |f| %>
        <%= f.input :gesture_handling,
              as: :boolean,
              boolean_style: :inline,
              wrapper: false,
              input_html: {
                data: {
                  action: "change->map--options#toggleGestureHandling",
                  map__options_target: "gestureHandling"
                }
              },
              label: t(".map_gesture_handling") %>
      <% end %>
    </li>
    <li class="border-b border-base-content/20 pb-2">
      <%= link_to tutorial_path("documentation-embed-map") do %>
        <%= lucide_icon "info", class: "inline-flex w-5" %>
        <%= t(".help_embed") %>
      <% end %>
    </li>
  <% end %>

  <li>
    <%= link_to export_merchants_path(format: :gpx, **request.query_parameters),
          target: :_blank,
          rel: "noopener",
          id: "download_merchants" do %>
      <span>
        <%= lucide_icon "download", class: "inline-flex w-5 mr-2" %>
        <%= t(".export_as_gpx") %>
      </span>
    <% end %>
  </li>

  <li class="border-b border-base-content/20 pb-2">
    <%= link_to tutorial_path("import-merchants-in-comaps") do %>
      <%= lucide_icon "info", class: "inline-flex w-5" %>
      <%= t(".import_gpx_to_comaps") %>
    <% end %>
  </li>

  <% if can_refresh_merchants?(merchant_sync) %>
    <li>
      <%= button_to refresh_merchants_path,
            class: "cursor-pointer",
            data: {
              turbo_confirm: t(".refresh_confirm_html")
            } do %>
        <%= lucide_icon "refresh-cw", class: "w-5 inline-flex mr-2" %>
        <%= t(".refresh") %>
      <% end %>
    </li>
  <% end %>

  <li>
    <%= link_to "https://t.me/Monero_map_labelers",
          target: :_blank,
          rel: "noopener" do %>
      <div>
        <%= inline_svg_tag(
              "contacts/telegram.svg",
              class: "inline-flex rounded-full bg-white text-[#27A7E7] w-5 h-5 mr-2",
              title: "Telegram",
              alt: "Logo Telegram"
            ) %>

        <span>Monero map labelers</span>
      </div>
    <% end %>
  </li>

  <li>
    <%= link_to "https://matrix.to/#/#bankexit:matrix.org",
          target: :_blank,
          rel: "noopener" do %>
      <div>
        <%= inline_svg_tag(
              "contacts/matrix.svg",
              class: "inline-flex w-5 h-5 mr-2",
              title: "Matrix Bank-Exit",
              alt: "Matrix Bank-Exit"
            ) %>

        <span>Matrix (#bankexit:matrix.org)</span>
      </div>
    <% end %>
  </li>

  <% if authenticated? && allowed_to?(:index?, Merchant, namespace: Admin) %>
    <li class="border-t border-base-content/20 pt-2">
      <%= link_to admin_merchants_path, class: "btn btn-success btn-sm" do %>
        <%= t(".view_in_admin") %>
      <% end %>
    </li>
  <% end %>
<% end %>

<%= render "application/dropdown_actions",
      details_html: {
        data: {
          controller: ("map--options" if merchants_as_map?)
        }
      },
      menu_html: "w-96",
      item_id: "map",
      aria: { label: "Map options" } %>
