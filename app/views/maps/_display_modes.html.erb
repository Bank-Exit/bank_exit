<% req_params = request.query_parameters.compact_blank %>
<% req_params.delete(:pagy) %>

<div class="flex items-center gap-2 max-md:w-full">
  <%= raw_link_to url_for(params: req_params.merge(display: :grid)), data: { turbo_stream: true },
            class: class_names('btn', 'max-md:w-1/2', 'btn-info': merchants_as_grid?),
            title: t("display_grid"),
            hotkey: "shift+g",
            size: "xs" do %>
    <%= lucide_icon "grid-3x3", class: "w-4" %>

    <span><%= t("display_grid") %></span>
  <% end %>

  <%= raw_link_to url_for(params: req_params.merge(display: :table)), data: { turbo_stream: true },
            class: class_names('btn', 'max-md:w-1/2', 'btn-info': merchants_as_table?),
            title: t("display_table"),
            hotkey: "shift+t",
            size: "xs" do %>
    <%= lucide_icon "rows-3", class: "w-4" %>

    <span><%= t("display_table") %></span>
  <% end %>
</div>
