<%# locals: (merchant_sync:, pagy:, h_screen: true) %>

<div class="w-full md:w-1/2 xl:w-1/3 overflow-y-auto p-3 space-y-3 @container <%= map_css_height if h_screen %>">
  <div class="flex @max-md:flex-col gap-2 items-center">
    <div class="flex @max-md:flex-col w-full gap-2 items-center">
      <%= raw_link_to new_merchant_proposal_path,
                    class: 'btn btn-success text-xs @max-md:w-full',
                    hotkey: 'a' do %>
        <%= lucide_icon 'store', class: 'w-5' %>
        <%= t('.suggest_merchant') %>
      <% end %>

      <%= raw_link_to directories_path,
                    hotkey: 'd',
                    class: 'btn btn-warning text-xs @max-md:w-full' do %>
        <%= lucide_icon 'notebook', class: 'w-5' %>
        <%= t('application.header.directories') %>
      <% end %>
    </div>

    <%= render 'maps/dropdown_map_actions', merchant_sync: merchant_sync %>
  </div>

  <%= render 'maps/display_modes' %>

  <details
    class="collapse collapse-arrow bg-base-200"
    data-controller="search"
    open
  >
    <summary
      class="collapse-title text-sm place-content-between items-center flex!"
      tabindex="0"
    >
      <div class="flex items-center gap-1">
        <%= lucide_icon 'search', class: 'w-4' %>
        <span class="font-bold"><%= t('filters') %></span>
      </div>

      <div id="merchants_count" class="text-xs justify-self-end">
        <%= render 'maps/merchants_count', pagy: pagy %>
      </div>
    </summary>

    <div class="collapse-content">
      <%= render 'maps/filters_form' %>
    </div>
  </details>

  <%= yield %>
</div>
