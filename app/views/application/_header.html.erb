<%# locals: (projects:, tutorials:, highlighted_tutorials:, bitcoin_tutorial:) %>

<% grocery = projects.find(&:grocery?)
business_guide_tutorial = tutorials.find(&:cryptopayment_for_business?)
accounting_tutorial = tutorials.find(&:accounting?)

active_projects = controller_name == "projects"
active_blogs = controller_name == "blogs"
active_map = controller_path.in?(%w[maps merchants merchants/itineraries])
active_directories = controller_name == "directories"
active_merchants = active_map || active_directories
active_guides = controller_name.in?(%w[blogs tutorials ecosystems]) && params[:id] != 'flyer'
active_about = controller_name.in?(%w[local_groups collectives media])

megamenu_popover_class = "flex max-lg:flex-col lg:items-center gap-6 lg:py-3"
root_menu_active_class = "lg:bg-base-300 lg:rounded-md"

background_header = "bg-base-100/90 shadow-sm backdrop-blur" %>

<header
  class="
    <%= class_names(
    "fixed inset-x-0 z-50 print:hidden transition-colors duration-300",
    background_header => !current_page?(root_path)
    ) %>
  "
  data-controller="<%= 'header' if current_page?(root_path) %>"
  data-header-background-class="<%= background_header %>"
>
  <div class="navbar">
    <div class="navbar-start max-sm:w-full">
      <%= link_to root_path,
            class: "flex items-center gap-3",
            data: {
              controller: "hotkey",
              action: "keydown.shift+0@document->hotkey#click"
            } do %>
        <%= image_tag logo_by_locale, class: 'w-12', alt: "Logo #{t('.bank_exit')}", width: 48, height: 48 %>

        <div>
          <div class="font-bold lg:text-lg">
            <%= t('.bank_exit') %>
          </div>

          <div class="text-xs opacity-60">
            <%= t(".subtitle") %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="navbar-center">
      <div
        class="megamenu max-lg:megamenu-vertical lg:gap-2"
        id="main_menu"
        popover
      >
        <span class="megamenu-active"></span>

        <button
          popovertarget="d1"
          class="<%= class_names("#{root_menu_active_class}": active_merchants) %>"
        >
          <%= t(".merchants") %>
        </button>

        <div id="d1" class="megamenu-popover-item" popover>
          <div class="<%= megamenu_popover_class %>">
            <ul class="menu menu-horizontal items-start gap-6">
              <li>
                <%= raw_link_to maps_path,
                      class: class_names("menu-active": active_map),
                      hotkey: 'shift+1',
                      size: 'xs' do %>
                  <%= t('.map') %>
                <% end %>

                <ul class="mb-3">
                  <% Setting::MERCHANTS_FILTER_COINS.each do |coin| %>
                    <li>
                      <%= link_to maps_path(coins: [coin]) do %>
                        <div class="avatar">
                          <div class="w-5">
                            <%= image_tag "coins/logo-#{coin}.svg", alt: "Logo #{coin}" %>
                          </div>
                        </div>

                        <%= coin.capitalize %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>

                <ul class="mb-3">
                  <% I18n.available_locales.each do |locale| %>
                    <li>
                      <% locale = :gb if locale == :en %>

                      <%= link_to maps_path(country: locale.upcase) do %>
                        <%= formatted_country(locale) %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>

                <%= link_to statistics_path,
                        class: class_names(
                            "btn btn-secondary",
                        ) do %>
                  <%= t('statistics.show.title') %>
                  <%= lucide_icon "chart-line" %>
                <% end %>
              </li>

              <li>
                <%= raw_link_to directories_path,
                        class: class_names("menu-active": active_directories),
                        hotkey: 'shift+2',
                        size: 'xs' do %>
                  <%= t('.directories') %>
                <% end %>

                <ul>
                  <% Setting::MERCHANTS_FILTER_COINS.each do |coin| %>
                    <li>
                      <%= link_to directories_path(coins: [coin]) do %>
                        <div class="avatar">
                          <div class="w-5">
                            <%= image_tag "coins/logo-#{coin}.svg", alt: "Logo #{coin}" %>
                          </div>
                        </div>

                        <%= coin.capitalize %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </li>
            </ul>

            <%= link_to maps_path, class: "md:max-w-sm max-lg:hidden mr-5" do %>
              <%= image_tag "map_light.jpg", class: "rounded-lg map-light", alt: "Map light preview", loading: :lazy %>
              <%= image_tag "map_dark.jpg", class: "rounded-lg map-dark", alt: "Map dark preview", loading: :lazy %>
            <% end %>
          </div>
        </div>

        <button
          popovertarget="d2"
          class="<%= class_names("#{root_menu_active_class}": active_projects) %>"
        >
          <%= t('.projects') %>
        </button>

        <div id="d2" class="megamenu-popover-item" popover>
          <div class="<%= megamenu_popover_class %>">
            <ul class="menu">
              <li>
                <%= raw_link_to projects_path,
                                hotkey: 'shift+3',
                                size: 'xs' do %>
                  <%= t('.projects') %>
                <% end %>

                <ul>
                  <% projects.each do |project| %>
                    <li>
                      <%= link_to project_path(project),
                                class: ('menu-active' if current_page?(project_path(project))) do %>
                        <%= project.title %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </li>
            </ul>

            <%= link_to project_path(grocery), class: "md:max-w-sm max-lg:hidden" do %>
              <%= image_tag "projects/grocery/cover.jpg", class: "rounded-lg", alt: "Epicerie Libre Monero", loading: :lazy %>
            <% end %>
          </div>
        </div>

        <button
          popovertarget="d3"
          class="<%= class_names("#{root_menu_active_class}": active_guides) %>"
        >
          <%= t(".guides") %>
        </button>

        <div id="d3" class="megamenu-popover-item" popover>
          <div class="<%= megamenu_popover_class %>">
            <ul class="menu menu-horizontal items-start">
              <li>
                <span class="text-base-content/50 uppercase">
                  <%= t('.articles') %>
                </span>

                <ul>
                  <li>
                    <%= raw_link_to blogs_path,
                                    class: class_names("menu-active": active_blogs),
                                    hotkey: 'shift+4',
                                    size: 'xs' do %>
                      <%= t('.blogs') %>
                    <% end %>
                  </li>

                  <li>
                    <%= raw_link_to tutorials_path,
                                    hotkey: 'shift+5',
                                    size: 'xs' do %>
                      <%= t('.tutorials') %>
                    <% end %>

                    <ul>
                      <% highlighted_tutorials.each do |tutorial| %>
                        <li>
                          <%= link_to tutorial,
                                    class: ('menu-active' if current_page?(polymorphic_path(tutorial))) do %>
                            <%= tutorial.title %>
                          <% end %>
                        </li>
                      <% end %>

                      <li>
                        <%= link_to bitcoin_tutorial,
                                class: ('menu-active' if current_page?(polymorphic_path(bitcoin_tutorial))) do %>
                          <%= bitcoin_tutorial.title %>
                        <% end %>
                      </li>
                    </ul>
                  </li>

                  <li>
                    <%= link_to ecosystem_path,
                      class: ('menu-active' if controller_name == "ecosystems") do %>
                      <%= t('ecosystems.show.title') %>
                      <%= image_tag icon_by_coin('monero'), class: 'w-5', alt: "Monero" %>
                    <% end %>
                  </li>
                </ul>
              </li>

              <li>
                <span class="text-base-content/50 uppercase">
                  <%= t('.pros') %>
                </span>

                <ul>
                  <li>
                    <%= link_to tutorial_path(business_guide_tutorial.identifier),
                          class: class_names('menu-active': current_page?(id: 'cryptopayment-for-business')) do %>
                      <%= business_guide_tutorial.short_title %>
                    <% end %>
                  </li>

                  <li>
                    <%= link_to tutorial_path('accounting'),
                          class: class_names('menu-active': current_page?(tutorial_path('accounting'))) do %>
                      <%= accounting_tutorial.title %>
                    <% end %>
                  </li>
                </ul>
              </li>
            </ul>
          </div>
        </div>

        <button
          popovertarget="d4"
          class="<%= class_names("#{root_menu_active_class}": active_about) %>"
        >
          <%= t('about') %>
        </button>

        <div id="d4" class="megamenu-popover-item" popover>
          <div class="<%= megamenu_popover_class %>">
            <ul class="menu md:menu-horizontal items-start">
              <li>
                <span class="text-base-content/50 uppercase">
                  <%= t('collectives.show.title') %>
                </span>

                <ul>
                  <li>
                    <%= link_to collective_path,
                          class: class_names('menu-active': controller_name == "collectives") do %>
                      <%= t('collectives.show.title') %>
                    <% end %>
                  </li>

                  <li>
                    <%= link_to local_groups_path,
                          class: class_names('menu-active': controller_name == "local_groups") do %>
                      <%= t("local_groups.index.title") %>
                      <%= inline_svg_tag "contacts/telegram.svg", class: 'inline-flex bg-white text-[#27A7E7] w-5 rounded-full', title: 'Telegram', alt: 'Logo Telegram' %>
                    <% end %>
                  </li>

                  <li>
                    <%= link_to media_path,
                            class: class_names('menu-active': controller_name == 'media') do %>
                      <%= t('media.index.title') %>
                    <% end %>
                  </li>

                  <li>
                    <%= link_to '#contact', data: { turbo: false }, onclick: "main_menu.hidePopover(); this.closest('[popover]').hidePopover();" do %>
                      <%= t('.contact') %>
                      <%= lucide_icon "anchor", class: "w-4" %>
                    <% end %>
                  </li>
                </ul>
              </li>
            </ul>

            <div class="avatar-group -space-x-6 md:max-w-sm max-lg:hidden">
              <div class="avatar">
                <div class="w-28">
                  <%= image_tag logo_by_locale, alt: "Bank-Exit logo", loading: :lazy %>
                </div>
              </div>

              <div class="avatar">
                <div class="w-28">
                  <%= image_tag 'logo_by_mondetta.jpeg', alt: 'Logo Bank-Exit by Mondetta' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="navbar-end gap-1 md:gap-3">
      <div class="flex items-center gap-0.5">
        <button
          aria-label="Search"
          class="btn btn-ghost btn-circle"
          data-controller="hotkey"
          data-action="keydown.ctrl+k@document->hotkey#click"
          commandfor="search_modal"
          command="show-modal"
        >
          <%= lucide_icon 'search', class: "h-5 w-5" %>
        </button>

        <%= hotkey_label(['ctrl', 'k'], size: 'xs') %>
      </div>

      <%= render 'application/language_switcher', show_current_label: false %>

      <%= link_to maps_path, class: 'btn btn-primary btn-sm max-md:hidden' do %>
        <%= t(".access_map") %>
      <% end %>

      <button
        aria-label="Menu"
        class="btn btn-square btn-soft lg:hidden"
        popovertarget="main_menu"
      >
        <%= lucide_icon "menu" %>
      </button>
    </div>
  </div>

  <div id="flashes"><%= render 'application/flashes' %></div>
</header>
