<dialog
  id="search_modal"
  class="modal items-start pt-12"
  data-controller="research"
  data-action="toggle->research#toggle"
  data-research-search-url-value="<%= search_path %>"
>
  <div class="modal-box p-0! w-11/12 lg:w-2/3 max-w-3xl">
    <form
      class="flex items-center bg-base-200 pr-1.5"
      data-action="reset->research#search"
      id="research"
    >
      <div class="relative w-full">
        <input
          type="text"
          autocomplete="false"
          class="p-3 w-full text-lg pl-12 peer focus-visible:outline-none!"
          data-action="input->research#search"
          data-research-target="input"
          name="query"
          placeholder="<%= t('simple_form.placeholders.research.search') %>"
        >

        <%= lucide_icon 'search', class: 'w-8 absolute top-1/2 -translate-y-1/2 left-2 peer-focus:text-primary' %>

        <span
          class="spinner hidden absolute right-2 top-1/2 -translate-y-1/2 z-1"
          data-research-target="spinner"
        >
          <span class="loading loading-spinner w-8 h-8 text-primary"></span>
        </span>
      </div>

      <button
        class="btn btn-primary btn-circle"
        role="button"
        tabindex="0"
        title="<%= t('maps.filters_form.clear_search_query') %>"
        type="reset"
      >
        <%= lucide_icon 'undo', class: 'p-1' %>
      </button>
    </form>

    <%= turbo_frame_tag :search_results,
                        data: {
                          research_target: :frame,
                           action: "turbo:frame-load->research#loaded"
                        } do %>
      <%= render "application/loader_noscript", message_noscript: "JavaScript is required to display results" %>
    <% end %>

    <footer class="mb-2 text-xs space-y-2">
      <hr class="border-base-content/20">

      <p
        class="
          hide-on-touch max-sm:hidden md:flex items-center justify-end gap-2
          px-2 js-only
        "
      >
        <span>
          <%== hotkey_label('tab', size: 'xs') %>&nbsp; <%= t('or') %>&nbsp;
          <%== hotkey_label(['shift', 'tab'], size: 'xs') %>&nbsp;
          <%= t('.to_navigate') %>
        </span>

        <span>
          <%== hotkey_label('esc', size: 'xs') %>&nbsp;
          <%= t('.to_close_modal') %>
        </span>
      </p>

      <p class="text-center text-xs">
        <% heart = lucide_icon('heart', class: 'h-4 w-4 stroke-red-600 fill-red-600 inline-flex mx-0.5 hover:scale-150 motion-safe:transition-transform') %><%= t('application.footer.developed_by_html', heart: heart) %>
      </p>
    </footer>
  </div>

  <form method="dialog" class="modal-backdrop -mt-12">
    <button>Close</button>
  </form>
</dialog>
