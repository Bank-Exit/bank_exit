<footer class="<%= class_names(["container mx-auto bg-base-100 text-base-content p-5 lg:p-10 border-base-content/10 border-t print:hidden", 'snow-stack': themes_finder.christmas_time?]) %>">
  <% unless params[:controller] == 'risks' %>
    <%= render "risks/risks" %>
  <% end %>

  <div
    class="
      footer grid-cols-1 md:grid-cols-2 lg:grid-cols-4 md:justify-items-center md:place-content-evenly
      max-sm:footer-vertical
    "
  >
    <nav>
      <h2 class="footer-title">
        <%= t('application.header.collectif') %> <%= t('application.header.bank_exit') %>
      </h2>

      <div class="max-sm:hidden hide-on-touch flex items-center gap-2">
        <button
          aria-label="Help modal"
          class="
            block cursor-pointer hover:text-primary
            motion-safe:transition-colors js-only
          "
          commandfor="modal_help"
          command="show-modal"
          data-controller="hotkey"
          data-action="keydown.shift+question@document->hotkey#click"
        >
          <%= lucide_icon 'circle-question-mark', class: 'w-4 inline-flex' %>
          <%= t('help') %>
        </button>

        <%= hotkey_label(['shift', '?'], size: 'xs') %>
      </div>

      <div class="flex items-center gap-2">
        <button
          aria-label="About modal"
          class="
            block cursor-pointer hover:text-primary
            motion-safe:transition-colors
          "
          commandfor="modal_about"
          command="show-modal"
          data-controller="hotkey"
          data-action="keydown.ctrl+i@document->hotkey#click"
        >
          <%= lucide_icon 'info', class: 'w-4 inline-flex' %>
          <%= t('about') %>
        </button>

        <%= hotkey_label(['ctrl', 'i'], size: 'xs') %>
      </div>

      <%= link_to 'https://bank-exit-uptime-production.up.railway.app/status/bank-exit',
                  class: 'block',
                  target: :_blank do %>
        <div class="inline-grid mr-1 *:[grid-area:1/1]">
          <div class="status status-success motion-safe:animate-ping"></div>
          <div class="status status-success"></div>
        </div>

        <%= t('status') %>
      <% end %>

      <% if themes_finder.christmas_time? %>
        <%= render 'application/snowflakes' %>
      <% end %>

      <%= render 'application/theme_switcher' %>

      <%= image_tag 'logo_by_mondetta.jpeg',
            class: 'w-32 mx-auto rounded-full mt-4',
            title: 'Logo by Mondetta',
            alt: 'Logo by Mondetta',
            width: 128, height: 128 %>
    </nav>

    <nav>
      <h2 class="footer-title">
        <%= t('.navigation') %>
      </h2>

      <%= link_to t('application.header.home'), root_path %>
      <%= link_to t('collectives.show.title'), collective_path %>

      <span>
        <%= link_to t('application.header.map'), maps_path %>
        <span class="opacity-60 mx-1"> &bull; </span>
        <%= link_to t('application.header.directories'), directories_path %>
      </span>

      <span>
        <%= link_to t('application.header.blogs'), blogs_path %>
        <span class="opacity-60 mx-1"> &bull; </span>
        <%= link_to t('application.header.tutorials'), tutorials_path %>
      </span>

      <%= link_to local_groups_path do %>
        <%= t('local_groups.index.title') %>
        <%= inline_svg_tag "contacts/telegram.svg", class: 'inline-flex ml-2 bg-white rounded-full text-[#27A7E7] w-5', title: 'Telegram', alt: 'Logo Telegram' %>
      <% end %>

      <%= link_to t('media.index.title'), media_path %>
      <%= link_to t('application.header.faq'), faq_path %>
      <%= link_to t('glossaries.show.title'), glossaries_path %>

      <%= link_to statistics_path do %>
        <%= t('statistics.show.title') %>
      <% end %>

      <%= link_to license_path, target: :_blank do %>
        <%= t('.license') %>
      <% end %>
    </nav>

    <nav>
      <h2 class="footer-title"><%= t('.projects') %></h2>

      <% projects.each do |project| %>
        <%= link_to project_path(project) do %>
          <%= project.title %>
        <% end %>
      <% end %>
    </nav>

    <%= render 'application/contacts', contacts: contacts %>
  </div>
</footer>

<footer
  class="
    footer bg-base-200 text-base-content
    border-base-content/10 border-t lg:px-10 p-4 justify-center
    lg:justify-start print:hidden
  "
>
  <aside class="container mx-auto">
    <div
      class="
        grid grid-cols-1 lg:grid-flow-col items-center text-center
        lg:text-left gap-4
      "
    >
      <%= image_tag logo_by_locale,
            class: 'w-16 h-16 mx-auto object-cover rounded-full',
            alt: 'Logo Bank-Exit',
            width: 64, height: 64 %>

      <p>
        <%= t('.copyright_html', year: Date.current.year) %>

        <br>

        <% heart = lucide_icon('heart', class: 'h-5 w-5 stroke-red-600 fill-red-600 inline-flex mx-0.5 hover:scale-150 motion-safe:transition-transform') %>
        <%= t('.developed_by_html', heart: heart) %>

        <% unless authenticated? %>
          <%= link_to '.', new_session_path %>
        <% end %>
      </p>
    </div>
  </aside>
</footer>
