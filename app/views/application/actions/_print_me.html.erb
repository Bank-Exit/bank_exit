<%# locals: (in_menu: false, label_value: nil, icon_klass: "w-6 h-6") %>

<% if in_menu %>
  <%= button_tag type: :button,
                 class: 'flex items-center gap-2 cursor-pointer',
                 data: {
                   controller: 'printer',
                   action: 'click->printer#print'
                 } do %>
    <%= lucide_icon 'printer', class: icon_klass %>
    <%= label_value if label_value %>
    <%= hotkey_label(['ctrl', 'p'], size: 'xs') %>
  <% end %>
<% else %>
  <div class="flex items-center gap-2">
    <%= button_tag type: :button,
               class: 'btn btn-circle',
               title: t('print'),
               data: {
                 controller: 'printer',
                 action: 'click->printer#print'
               } do %>
      <%= lucide_icon 'printer', class: icon_klass %>
      <%= label_value if label_value %>
    <% end %>

    <%= hotkey_label(['ctrl', 'p'], size: 'xs') %>
  </div>
<% end %>
