<%# locals: (in_menu: false, label_value: nil, subject:, body:, icon_klass: "w-6 h-6") %>

<% if in_menu %>
  <%= mail_to "",
              subject: subject,
              body: body,
              class: 'flex items-center gap-2',
              data: { \
                controller: 'hotkey', \
                action: "keydown.s@document->hotkey#click" \
              } do %>
    <%= lucide_icon 'mail', class: icon_klass %>
    <%= label_value if label_value %>
    <%= hotkey_label('s', size: 'xs') %>
  <% end %>
<% else %>
  <div class="flex items-center gap-2">
    <%= mail_to "",
                subject: subject,
                body: body,
                class: 'btn btn-circle',
                title: t('share_by_email'),
                data: { \
                  controller: 'hotkey', \
                  action: "keydown.s@document->hotkey#click" \
                } do %>
      <%= lucide_icon 'mail', class: icon_klass %>
      <%= label_value if label_value %>
    <% end %>

    <%= hotkey_label('s', size: 'xs') %>
  </div>
<% end %>
