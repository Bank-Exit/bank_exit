<%# locals: (article:, previous_article:, next_article:) %>

<article>
  <header
    class="
      <%= class_names(
      "hero",
      "bg-fixed",
      "bg-#{article.banner}": article.banner,
      "bg-banner-default": !article.banner
      ) %>
    "
  >
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="max-w-5xl space-y-8">
        <div class="space-y-4">
          <h1 class="text-3xl font-bold lg:text-4xl">
            <%= article.title %>
          </h1>

          <% if article.overview.present? %>
            <p class="text-lg opacity-90">
              <%= article.overview %>
            </p>
          <% end %>
        </div>

        <div class="flex flex-wrap justify-center gap-2">
          <div class="badge badge-md gap-2">
            <% if article.author %>
              <%= lucide_icon "user" %>
              <%= t('by') %>
              <%= article.author %>
            <% else %>
              <div class="avatar flex items-center gap-2">
                <div class="w-12 rounded">
                  <%= image_tag logo_by_locale,
                          alt: "Logo Bank-Exit",
                          width: 48, height: 48 %>
                </div>

                <span>
                  <%= t('by') %> <%= t('application.header.bank_exit') %>
                </span>
              </div>
            <% end %>
          </div>

          <% if article.created_at? %>
            <span class="badge badge-md gap-2">
              <%= lucide_icon "calendar-days" %>

              <time datetime="<%= article.created_at.iso8601 %>">
                <%= l(article.created_at, format: :long) %>
              </time>
            </span>
          <% end %>

          <% if article.level? %>
            <span class="badge badge-md gap-2 <%= tutorial_class_by_level(article.level) %>">
              <%= lucide_icon "signal" %>
              <%= t(".#{article.level}") %>
            </span>
          <% end %>

          <% if article.time? %>
            <span
              class="badge badge-neutral badge-md gap-2"
              title="<%= article.time %> min"
            >
              <%= lucide_icon "clock" %>
              <%= distance_of_time_in_words(article.time.minutes) %>
            </span>
          <% end %>
        </div>

        <%= yield :header_actions %>
        <%= yield :outdated_content %>

        <% if article.missing_content_for_locale? %>
          <p class="alert alert-warning lg:w-2/3 mx-auto">
            <%= t("missing_content_for_locale") %>
          </p>
        <% end %>
      </div>
    </div>
  </header>

  <section class="max-w-5xl mx-auto p-5 pb-10 space-y-8">
    <%= render "application/breadcrumb" %>
    <%= yield :coins %>

    <%= highlight(article.render_template, sanitize(params[:q]), sanitize: false) %>

    <p class="text-xs italic text-right">
      <% icon = article.human? ? "bot-off" : "bot" %>
      <%= lucide_icon icon, class: 'inline w-3.5' %>

      <%= t(".#{article.content_origin}") %>
    </p>

    <% navigation_justify =
      if previous_article && next_article
        "justify-between"
      elsif previous_article
        "justify-start"
      else
        "justify-end"
      end %>

    <div class="flex max-md:flex-col <%= navigation_justify %> gap-3">
      <% if previous_article %>
        <%= link_to polymorphic_path(previous_article),
                    class: "group card card-side items-start md:w-1/2 lg:w-2/5 min-w-0 gap-0 bg-base-200 hover:text-primary",
                    data: {
                      controller: 'hotkey',
                      action: "keydown.ctrl+left@document->hotkey#click",
                      hotkey_prevent_focus_scroll_value: "true"
                    } do %>
          <% if previous_article.logo? %>
            <figure class="shrink-0 overflow-hidden">
              <%= image_tag previous_article.logo,
                alt: previous_article.title,
                class: "size-20 object-cover motion-safe:transition-transform motion-safe:group-hover:scale-115 motion-safe:group-focus-visible:scale-115" %>
            </figure>
          <% end %>

          <div class="card-body py-2 px-3 min-w-0 gap-0">
            <p class="text-xs uppercase text-base-content/50 mb-1">
              <%= lucide_icon "arrow-left", class: "inline-flex w-4" %> <%= t('.prev_article') %>
              <%= hotkey_label(['Ctrl', '◀︎'], size: 'xs') %>
            </p>

            <p class="font-semibold truncate">
              <%= previous_article.title %>
            </p>

            <% if previous_article.created_at %>
              <time class="text-xs opacity-40"><%= l(previous_article.created_at) %></time>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if next_article %>
        <%= link_to polymorphic_path(next_article),
                    class: "group card card-side items-start md:w-1/2 lg:w-2/5 min-w-0 gap-0 text-right bg-base-200 hover:text-primary",
                    data: {
                      controller: 'hotkey',
                      action: "keydown.ctrl+right@document->hotkey#click",
                      hotkey_prevent_focus_scroll_value: "true"
                    } do %>
          <div class="card-body py-2 px-3 min-w-0 gap-0">
            <p class="text-xs uppercase text-base-content/50 mb-1">
              <%= hotkey_label(['Ctrl', '▶︎'], size: 'xs') %> <%= t('.next_article') %>
              <%= lucide_icon "arrow-right", class: "inline-flex w-4" %>
            </p>

            <p class="font-semibold truncate">
              <%= next_article.title %>
            </p>

            <% if next_article.created_at %>
              <time class="text-xs opacity-40"><%= l(next_article.created_at) %></time>
            <% end %>
          </div>

          <% if next_article.logo? %>
            <figure class="shrink-0">
              <%= image_tag next_article.logo,
                alt: next_article.title,
                class: "size-20 object-cover motion-safe:transition-transform motion-safe:group-hover:scale-115 motion-safe:group-focus-visible:scale-115" %>
            </figure>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>

  <%= yield :footer_actions %>
</article>
