<%# locals: (merchant:) %>

<div class="alert alert-vertical overflow-y-auto gap-2">
  <% merchant.all_contacts.each do |key, value| %>
    <div class="flex items-center gap-2">
      <%= social_contact_icon(key) %>

      <% case key %>
      <% when :email %>
        <%= mail_to value, value %>
      <% when :phone %>
        <%= phone_to value, value %>
      <% when :session %>
        <%= value %>
      <% else %>
        <% if value.start_with?("http") %>
          <% cleaned_url = clean_url(CGI.unescape(value)) %>

          <% if cleaned_url %>
            <%= link_to(
                cleaned_url.truncate(50),
                value,
                target: :_blank,
                rel: "noopener"
              ) %>
          <% else %>
            Invalid URL
          <% end %>
        <% else %>
          <%= value %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
