<% image = @merchant.banner.attached? ? rails_blob_url(@merchant.banner) : image_url(logo_by_locale)

set_meta_tags og: { image: image },
              twitter: { image: image } %>

<div class="flex flex-col md:flex-row">
  <div
    class="
      <%= class_names(
      'md:w-1/2 xl:w-1/3 overflow-y-auto space-y-3 p-3',
      map_css_height
      ) %>
    "
  >
    <div class="flex justify-between print:hidden gap-3">
      <%= render 'application/breadcrumb', size: 'text-sm' %>

      <%= render 'merchants/view_sections/dropdown_actions',
                 merchant: @merchant,
                 btn_klass: 'btn-md' %>
    </div>

    <% if @merchant.deleted? %>
      <p class="alert alert-error">
        <%= lucide_icon 'info', class: 'inline-flex w-4 h-4' %>

        <span>
          <%= t('.soft_deleted_warning', date: l(@merchant.deleted_at.to_date)) %>
        </span>
      </p>
    <% end %>

    <% if @merchant.might_be_outdated? %>
      <p class="alert alert-warning">
        <%= lucide_icon 'triangle-alert', class: 'inline-flex w-4 h-4' %>

        <span>
          <%= t('.last_survey_warning_html',
                date: time_ago_in_words(@merchant.last_survey_on),
                raw_date: l(@merchant.last_survey_on)) %>
        </span>
      </p>
    <% end %>

    <article class="space-y-6">
      <header class="flex flex-col items-center space-y-3 rounded-lg">
        <div class="relative">
          <%= render 'application/logo_or_initials',
                     model: @merchant,
                     mode: :extra_large %>

          <div class="absolute -bottom-4 -right-3">
            <%= merchant_icon_svg(@merchant.icon, width: 50, height: 50) %>
          </div>
        </div>

        <h1 class="text-3xl text-center">
          <%= @merchant.name %>
        </h1>

        <% if @merchant.category.present? %>
          <p class="badge badge-secondary">
            <%= @merchant.friendly_category %>
          </p>
        <% end %>

        <% if @merchant.address? %>
          <div class="alert alert-vertical text-center">
            <%= formatted_address(@merchant.address_lines) %>
          </div>
        <% end %>
      </header>

      <div class="avatar-group -space-x-3 justify-center">
        <%= render @merchant.pretty_coins, group: true %>

        <% unless @merchant.ask_kyc.nil? %>
          <div class="my-1">
            <div class="avatar">
              <%= merchant_kyc_no_kyc(
                @merchant.ask_kyc?,
                klass: 'w-16 h-16 text-xl'
              ) %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @merchant.description? %>
        <section>
          <h2 class="mb-2 uppercase font-bold text-primary">
            <%= t('description') %>
          </h2>

          <div class="alert">
            <%= @merchant.description %>
          </div>
        </section>
      <% end %>

      <% if @merchant.contact? %>
        <section>
          <h2 class="mb-2 uppercase font-bold text-primary">
            <%= t('contact') %>
          </h2>

          <%= render 'merchants/contacts',
                     merchant: @merchant %>
        </section>
      <% end %>

      <%= render 'merchants/view_sections/other_informations',
                 merchant: @merchant %>

      <%= render 'merchants/view_sections/itinerary',
                 merchant: @merchant %>

      <% if allowed_to?(:index?, Comment) %>
        <div>
          <%= turbo_frame_tag :comments_wrapper,
                              src: merchant_comments_path(@merchant),
                              loading: :lazy do %>
            <%= render 'application/loader_noscript',
                       message_noscript: 'JavaScript is required to display comments' %>
          <% end %>
        </div>
      <% end %>

      <% if params[:debug] == 'true' %>
        <%= render 'merchants/view_sections/debug',
                   merchant: @merchant %>
      <% end %>

      <%= render 'merchants/last_survey_on',
                 merchant: @merchant %>
    </article>
  </div>

  <%= render 'merchants/map',
             merchant: @merchant %>

  <script type="application/ld+json">
    <%= json_escape(schema_dot_org_merchant(@merchant).to_json).html_safe %>
  </script>
</div>

<%= render template: 'faqs/show' if @faqs.any? %>
