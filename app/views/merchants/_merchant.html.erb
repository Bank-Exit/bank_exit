<%# locals: (merchant:, search: nil) %>

<%= link_to merchant_path(merchant), class: class_names("card card-border bg-base-200 hover:border-primary shadow-sm motion-safe:transition-all! break-inside-avoid mb-4", "image-full": merchant.banner.attached?) do %>
  <% if merchant.banner.attached? %>
    <figure>
      <%= image_tag merchant.banner.variant(:thumb), alt: "Banner" %>
    </figure>
  <% end %>

  <div class="card-body">
    <% if merchant.category.present? %>
      <span class="badge badge-warning">
        <%= merchant_icon_svg(merchant.icon, naked: true) %>
        <%= merchant.friendly_category %>
      </span>
    <% end %>

    <span class="card-title block mb-3"><%= highlight(merchant.name, search) %></span>

    <%= group_coins_list(
          merchant.coins,
          size: "w-7",
          class: "justify-center"
    ) do %>
      <% unless merchant.ask_kyc.nil? %>
        <%= merchant_kyc_no_kyc(
              merchant.ask_kyc?,
              klass: "w-7 text-[10px]"
        ) %>
      <% end %>
    <% end %>

    <div class="<%= class_names('@container', 'space-y-5') %>">
      <% if merchant.description.present? %>
        <blockquote class="italic">
          <%== highlight(
            merchant.description.truncate(150),
            search,
            sanitize: true
          ) %>
        </blockquote>
      <% end %>

      <div class="flex justify-center @max-sm:flex-col @max-sm:items-center gap-3">
        <% if merchant.address? %>
          <div class="flex flex-col items-center gap-1 text-center">
            <%= lucide_icon 'home', class: 'w-5' %>

            <div>
              <%== highlight(
                formatted_address(merchant.address_lines),
                search,
                sanitize: true
              ) %>
            </div>
          </div>
        <% end %>

        <% if merchant.delivery.present? %>
          <div class="flex flex-col items-center gap-1 text-center">
            <%= lucide_icon 'truck', class: 'w-5' %>

            <%= t('.home_delivery') %>

            <% if merchant.delivery_zone %>
              ( <%= merchant.delivery_zone %> )
            <% end %>
          </div>
        <% end %>
      </div>

      <% if allowed_to?(:index?, Comment) %>
        <% if merchant.comments_count > 0 %>
          <div class="flex items-center justify-center gap-3">
            <div
              title="<%= merchant.comments_count %> <%= Comment.model_name.human(count: merchant.comments_count) %>"
            >
              <%= lucide_icon 'message-square', class: 'inline-flex font-normal w-3' %>

              <%= merchant.comments_count %>
            </div>

            <div class="flex items-center gap-1">
              <div class="rating rating-xs">
                <div
                  class="mask mask-star bg-primary"
                  aria-label="<%= merchant.average_rating %> star"
                  aria-current="true"
                  title="<%= merchant.average_rating %>/5"
                ></div>
              </div>

              <p>
                <%= number_with_precision(
                  merchant.average_rating,
                  strip_insignificant_zeros: true,
                  precision: 2
                ) %>/5
              </p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
