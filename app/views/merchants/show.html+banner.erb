<% image = @merchant.banner.attached? ? rails_blob_url(@merchant.banner) : image_url(logo_by_locale)

set_meta_tags og: { image: image },
              twitter: { image: image } %>

<article>
  <div
    class="
      <%= class_names(
      'hero bg-fixed relative',
      'bg-cover lg:bg-contain': @merchant.banner.attached?,
      'bg-banner-default': !@merchant.banner.attached?
      ) %>
    "
    <% if @merchant.banner.attached? %>
      style="background-image: url(<%= rails_blob_path(@merchant.banner.variant(:thumb)) %>)"
    <% end %>
  >
    <div class="absolute top-3 right-3">
      <%= render 'merchants/view_sections/dropdown_actions',
                 merchant: @merchant,
                 btn_klass: 'btn-md' %>
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <header class="max-w-xl">
        <div class="text-center space-y-6">
          <%= render 'application/logo_or_initials',
                     model: @merchant,
                     mode: :extra_large %>

          <h1 class="text-3xl font-bold">
            <%= @merchant.name %>
          </h1>

          <% if @merchant.category.present? %>
            <div class="badge badge-secondary mx-auto">
              <%= merchant_icon_svg(@merchant.icon, width: 20, height: 20, naked: true) %>
              <%= @merchant.friendly_category %>
            </div>
          <% end %>

          <div class="avatar-group -space-x-3 justify-center">
            <%= render @merchant.pretty_coins, group: true %>

            <% unless @merchant.ask_kyc.nil? %>
              <div class="my-1">
                <div class="avatar">
                  <%= merchant_kyc_no_kyc(@merchant.ask_kyc?, klass: 'w-16 h-16 text-xl') %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </header>
    </div>
  </div>

  <div class="article-body max-w-5xl space-y-8!">
    <%= render 'application/breadcrumb' %>

    <% if @merchant.deleted? %>
      <p class="alert alert-error">
        <%= lucide_icon 'info', class: 'inline-flex w-4 h-4' %>

        <span>
          <%= t('.soft_deleted_warning', date: l(@merchant.deleted_at.to_date)) %>
        </span>
      </p>
    <% end %>

    <% if @merchant.might_be_outdated? %>
      <p class="alert alert-warning">
        <%= lucide_icon 'triangle-alert', class: 'inline-flex w-4 h-4' %>

        <span>
          <%= t('.last_survey_warning_html',
                date: time_ago_in_words(@merchant.last_survey_on),
                raw_date: l(@merchant.last_survey_on)) %>
        </span>
      </p>
    <% end %>

    <% if @merchant.description? %>
      <section>
        <h2 class="text-primary font-bold uppercase mb-2">
          <%= t('description') %>
        </h2>

        <div class="space-y-3">
          <%= simple_format(@merchant.description) %>
        </div>
      </section>
    <% end %>

    <% if @merchant.full_address.present? %>
      <section>
        <h2 class="text-primary font-bold uppercase mb-2">
          <%= t('address') %>
        </h2>

        <div class="alert">
          <%= formatted_address(@merchant.address_lines) %>
        </div>
      </section>
    <% end %>

    <%= render 'merchants/map',
               merchant: @merchant,
               map_width: 'w-full',
               map_height: 'h-[600px]' %>

    <% if @merchant.all_contacts.any? %>
      <section>
        <h2 class="text-primary font-bold uppercase mb-2">
          <%= t('contact') %>
        </h2>

        <%= render 'merchants/contacts',
                   merchant: @merchant %>
      </section>
    <% end %>

    <%= render 'merchants/view_sections/other_informations',
               merchant: @merchant %>

    <%= render 'merchants/view_sections/itinerary',
               merchant: @merchant %>

    <% if allowed_to?(:index?, Comment) %>
      <div>
        <%= turbo_frame_tag :comments_wrapper,
                            src: merchant_comments_path(@merchant),
                            loading: :lazy do %>
          <%= render 'application/loader_noscript',
                     message_noscript: 'JavaScript is required to display comments' %>
        <% end %>
      </div>
    <% end %>

    <% if params[:debug] == 'true' %>
      <%= render 'merchants/view_sections/debug',
                 merchant: @merchant %>
    <% end %>

    <%= render 'merchants/last_survey_on',
               merchant: @merchant %>
  </div>

  <script type="application/ld+json">
    <%= json_escape(schema_dot_org_merchant(@merchant).to_json).html_safe %>
  </script>
</article>

<%= render template: 'faqs/show' if @faqs.any? %>
